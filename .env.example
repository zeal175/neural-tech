# Enclave lives at /enclave on this same app. Leave unset (or /enclave).
# Do NOT set this to http://localhost:3001 — that was the old standalone app.
# NEXT_PUBLIC_ENCLAVE_URL=/enclave

# Enclave UPI on /enclave/register (QR file: public/enclave/upi-qr.png)
# NEXT_PUBLIC_UPI_QR=/enclave/upi-qr.png
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_NAME="Neural Techgenix Club"
NEXT_PUBLIC_UPI_AMOUNT=50

# Organizer PIN for /enclave/admin (payment screenshots) and /enclave/checkin
