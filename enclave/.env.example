# Supabase (preferred). Run scripts/enclave-registrations.sql in the SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# optional client key (not required for registration)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# UPI on /register — put the QR image at public/upi-qr.png (or set a path below).
# NEXT_PUBLIC_UPI_QR=/upi-qr.png
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_NAME="Neural Techgenix Club"
NEXT_PUBLIC_UPI_AMOUNT=50

# Organizer PIN for /admin (payment screenshots) and optionally /checkin
ADMIN_PIN=
CHECKIN_PIN=

# Optional Google Sheet instead of Supabase (legacy):
# REGISTRATIONS_WEBHOOK_URL=

# Final site URL for link previews (optional on Vercel)
NEXT_PUBLIC_SITE_URL=

# Club site (navbar “Club site” link). Local: http://localhost:3000
# NEXT_PUBLIC_CLUB_URL=
